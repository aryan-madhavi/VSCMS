# ==============================================================================
# Vehicle Service Center Management System (VSCMS)
# Environment Configuration Template
# Copy this file to '.env' before running with Podman Compose:
#   cp .env.example .env
# ==============================================================================

# --- MySQL Database Configuration ---
MYSQL_DATABASE=vscms_db
MYSQL_USER=vscms_user
MYSQL_PASSWORD=vscms_secure_pass_2026
MYSQL_ROOT_PASSWORD=vscms_root_pass_2026
MYSQL_HOST=db
MYSQL_PORT=3306

# Local Host Port Mapping (optional debugging on host machine, default 3306)
# Set to 3307 to avoid collision with any existing host MySQL/MariaDB service on 3306
HOST_MYSQL_PORT=3307

# --- Backend Application Configuration ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=mysql+pymysql://vscms_user:vscms_secure_pass_2026@db:3306/vscms_db

# Security & JWT Token Settings
# IMPORTANT: Generate a strong secret locally using: openssl rand -hex 32
JWT_SECRET_KEY=change_me_to_a_secure_random_32_byte_hex_string_for_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Initial Default Administrator (Created during DB seed if enabled)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@vscms.local
INITIAL_ADMIN_PASSWORD=Admin@123
INITIAL_ADMIN_FULLNAME=System Administrator

# --- Frontend Configuration ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=/api
